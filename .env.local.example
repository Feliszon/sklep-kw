# Skopiuj do .env.local (lokalnie) i ustaw te same zmienne w Vercel → Settings → Environment Variables.

# --- Adres strony (bez ukośnika na końcu) - używany w linkach P24, mailach i sitemap ---
SITE_URL=http://localhost:3000

# --- Panel admina ---
# Silne hasło (min. 16 znaków). Wygeneruj sekret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Firebase Realtime Database (Admin SDK) ---
FIREBASE_DATABASE_URL=https://<projekt>-default-rtdb.europe-west1.firebasedatabase.app
# Cała zawartość pliku JSON konta serwisowego (surowy JSON albo base64)
FIREBASE_SERVICE_ACCOUNT=

# --- Przelewy24 ---
# sandbox | production
P24_ENV=sandbox
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC_KEY=

# --- Zdjęcia produktów (Vercel Blob) - Vercel ustawia automatycznie po podłączeniu Blob Store ---
# Bez tej zmiennej zdjęcia zapisują się lokalnie w public/uploads (tylko do developmentu).
BLOB_READ_WRITE_TOKEN=

# --- E-maile (SMTP) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Sklep KW Poznań <sklep@kw.poznan.pl>"
# Na ten adres przychodzą powiadomienia o nowych zamówieniach
SHOP_NOTIFY_EMAIL=klub@kw.poznan.pl
